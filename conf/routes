# Routes
# This file defines all application routes (Higher priority routes first)
# https://www.playframework.com/documentation/latest/ScalaRouting
# ~~~~

# An example controller showing a sample home page
GET     /dashboard/:id                           controllers.DashboardController.getData(id: String)
POST    /dashboard/save/:id                      controllers.DashboardController.saveData(id: String)

# Google Calendar OAuth
GET     /auth/google/redirect                    controllers.GoogleAuthController.redirect
GET     /auth/google/callback                    controllers.GoogleAuthController.callback

# Calendar data
GET     /calendar/status/:userId                 controllers.GoogleAuthController.status(userId: String)
GET     /calendar/events/:userId                 controllers.GoogleAuthController.events(userId: String)
POST    /calendar/disconnect/:userId             controllers.GoogleAuthController.disconnect(userId: String)

# Map static resources from the /public folder to the /assets URL path
GET     /assets/*file               controllers.Assets.versioned(path="/public", file: Asset)
